<!-- UR5e with a pillar in the way of a direct joint move. -->
<sdf version="1.6">
  <world name="default">
    <model name="my_robot">
      <include>
        <uri>model://intrinsic/robot_definitions/ur/ur5e</uri>
      </include>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>0.45 0.30 0.30 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.60</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.60</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
