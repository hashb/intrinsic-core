# Minimal settings for building the planner natively (macOS or Linux) with the
# host C++ toolchain. Intentionally independent of ../.bazelrc.

common --enable_bzlmod
common --enable_workspace=false

common --cxxopt=-std=c++20
common --host_cxxopt=-std=c++20
common -c opt

# Silence warnings from code we do not own (external repos, including the
# generated intrinsic_src tree).
common --per_file_copt=external/.*@-w
common --host_per_file_copt=external/.*@-w

common --define absl=1
common --@nlopt//:use_luksan=false

common --incompatible_strict_action_env
common --repo_env=DO_NOT_TRACK=1

# `bazel build -c dbg` for debugging the planner.
common:dbg -c dbg --strip=never
