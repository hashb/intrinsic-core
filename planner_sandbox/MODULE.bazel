# Standalone, minimal build of the Intrinsic motion planner.
#
# Only the libraries the in-process planner needs are declared here. Sources
# come from the surrounding intrinsic-core checkout through the `intrinsic_src`
# repository (see bazel/intrinsic_src.bzl and tools/gen_manifest.py).

module(name = "planner_sandbox")

# Must come before rules_cc so the Xcode-aware C++ toolchain is preferred on
# macOS (the generic rules_cc one rejects SDKSettings.json in clang's deps).
bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_license", version = "1.0.0")

# C++ libraries used by the planner closure. Versions match the main
# intrinsic-core MODULE.bazel.
bazel_dep(name = "abseil-cpp", version = "20250814.2")
bazel_dep(name = "assimp", version = "6.0.5")
bazel_dep(name = "boost.filesystem", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.format", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.functional", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.graph", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.heap", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.iterator", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.logic", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.math", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.multiprecision", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.regex", version = "1.90.0.bcr.1")
bazel_dep(name = "cppregpattern", version = "1.0.1")
bazel_dep(name = "eigen", version = "5.0.1.bcr.2", repo_name = "com_gitlab_libeigen_eigen")
bazel_dep(name = "gloop", version = "20260828.0")
bazel_dep(name = "gz-math", version = "9.3.0")
bazel_dep(name = "googleapis", version = "0.0.0-20260929-28769825", repo_name = "com_google_googleapis")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "libzip", version = "1.12.1")
bazel_dep(name = "magic_enum", version = "0.9.8")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2", repo_name = "com_github_nlohmann_json")
bazel_dep(name = "nlopt", version = "2.10.1.bcr1")
bazel_dep(name = "octomap", version = "1.10.0")
bazel_dep(name = "onetbb", version = "2022.3.0")
bazel_dep(name = "openmesh", version = "11.0")
bazel_dep(name = "osqp-cpp", version = "0.0.0-20231004-4343373.bcr.2")
bazel_dep(name = "protobuf", version = "33.6", repo_name = "com_google_protobuf")
bazel_dep(name = "qhull", version = "8.0.2.bcr.2")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1", repo_name = "com_googlesource_code_re2")
bazel_dep(name = "riegeli", version = "0.0.0-20250822-9f2744d", repo_name = "com_google_riegeli")
bazel_dep(name = "sdformat", version = "16.1.0")
bazel_dep(name = "tinygltf", version = "2.9.6.bcr.1")
bazel_dep(name = "tinyxml2", version = "11.0.0")

archive_override(
    module_name = "gloop",
    patch_strip = 1,
    patches = ["//third_party:gloop.patch"],
    sha256 = "c4a32e9b582b2155dffa56867792a9d4d4931aa5575ade505a7672fce31d354d",
    strip_prefix = "gloop-20260828.0",
    urls = [
        "https://github.com/abseil/gloop/releases/download/20260828.0/gloop-20260828.0.tar.gz",
    ],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Collision checking.
http_archive(
    name = "coal",
    build_file = "//third_party:coal.BUILD.bazel",
    sha256 = "136d7f809fccd0027265dead58abb57798fc7631f1a3331f139a74bed92066cc",
    strip_prefix = "coal-1.0.1",
    urls = ["https://github.com/torresl-google/coal/archive/refs/tags/v1.0.1.tar.gz"],
)

# Polytope computations in TOPP reachability analysis.
http_archive(
    name = "cgal",
    build_file = "//third_party:cgal.BUILD.bazel",
    sha256 = "4a0713351882989dda8b6bbfa942d5013b994f297fbebe1096ce664a92aff1a0",
    strip_prefix = "cgal-6.2.1",
    url = "https://github.com/CGAL/cgal/archive/refs/tags/v6.2.1.tar.gz",
)

# Only ortools/base (strong_int, path and file helpers) is used. The overlay
# replaces or-tools' own BUILD file for that package so nothing else of
# or-tools (solvers, python, ...) is pulled in.
http_archive(
    name = "or_tools",
    build_file = "//third_party:or_tools_base.BUILD.bazel",
    integrity = "sha256-WZyHAxm7EnRB2SxFLY95vKRspv0pXB3rgDHtMDo2ExE=",
    patch_cmds = [
        "mv BUILD.bazel ortools/base/BUILD.bazel",
        "touch BUILD.bazel",
    ],
    strip_prefix = "or-tools-9.15",
    url = "https://github.com/google/or-tools/releases/download/v9.15/or-tools-9.15.tar.gz",
)

# The intrinsic-core sources needed by the planner, as one `intrinsic/...` tree.
intrinsic_src = use_repo_rule("//bazel:intrinsic_src.bzl", "intrinsic_src")

intrinsic_src(
    name = "intrinsic_src",
    manifest = "//gen:manifest.json",
    patches = [
        "//patches:macos_portability.patch",
        "//patches:no_grpc_status.patch",
        "//patches:no_object_world_client.patch",
        "//patches:no_ros_tf2.patch",
    ],
    stubs = "//stubs:BUILD.bazel",
)
