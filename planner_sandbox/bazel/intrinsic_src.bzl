"""Materializes the planner's intrinsic-core sources as one `intrinsic/` tree.

Files are symlinked from the surrounding checkout, so edits to the planner
sources are picked up by the next build. Files touched by a patch are copied
(and watched) instead, so the checkout itself is never modified. BUILD files
are generated from gen/manifest.json (see tools/gen_manifest.py).
"""

_LOADS = """\
load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
"""

_ATTR_ORDER = [
    "srcs",
    "hdrs",
    "textual_hdrs",
    "copts",
    "defines",
    "local_defines",
    "linkopts",
    "data",
    "alwayslink",
    "deps",
    "implementation_deps",
]

def _render_target(t):
    lines = ["%s(" % t["kind"], "    name = %s," % repr(t["name"])]
    for a in _ATTR_ORDER:
        if a in t:
            lines.append("    %s = %s," % (a, repr(t[a])))
    lines.append(")")
    return "\n".join(lines)

def _render_package(pkg):
    out = [
        "# Generated by planner_sandbox/bazel/intrinsic_src.bzl. Do not edit.",
        _LOADS,
        'package(default_visibility = ["//visibility:public"])',
        "",
    ]
    if pkg["exports"]:
        out.append("exports_files(%s)\n" % repr(pkg["exports"]))
    for t in pkg["targets"]:
        out.append(_render_target(t))
        out.append("")
    return "\n".join(out)

def _patched_files(rctx, patch):
    files = []
    for line in rctx.read(patch).splitlines():
        if line.startswith("+++ b/"):
            files.append(line[len("+++ b/"):].split("\t")[0])
    return files

def _intrinsic_src_impl(rctx):
    manifest_path = rctx.path(rctx.attr.manifest)
    manifest = json.decode(rctx.read(manifest_path))

    # planner_sandbox/gen/manifest.json -> checkout root.
    checkout = manifest_path.dirname.dirname.dirname
    stubs_dir = rctx.path(rctx.attr.stubs).dirname

    copied = {}
    for patch in rctx.attr.patches:
        for f in _patched_files(rctx, patch):
            copied[f] = True

    for upath, orig in manifest["files"].items():
        src = checkout.get_child(orig)
        if upath in copied:
            rctx.file(upath, rctx.read(src, watch = "yes"), legacy_utf8 = False)
        else:
            rctx.symlink(src, upath)

    for upath in manifest["stub_files"]:
        rctx.symlink(stubs_dir.get_child(upath), upath)

    # Bazel's built-in patcher rejects some valid unified diffs; use patch(1).
    for patch in rctx.attr.patches:
        res = rctx.execute(["patch", "-p1", "--batch", "-i", str(rctx.path(patch))])
        if res.return_code != 0:
            fail("Failed to apply %s:\n%s%s" % (patch, res.stdout, res.stderr))

    for pkg, contents in manifest["packages"].items():
        rctx.file(
            (pkg + "/BUILD.bazel") if pkg else "BUILD.bazel",
            _render_package(contents),
        )
    if "" not in manifest["packages"]:
        rctx.file("BUILD.bazel", "")

intrinsic_src = repository_rule(
    implementation = _intrinsic_src_impl,
    attrs = {
        "manifest": attr.label(mandatory = True, allow_single_file = True),
        "patches": attr.label_list(allow_files = [".patch"]),
        "stubs": attr.label(
            mandatory = True,
            allow_single_file = True,
            doc = "Any file at the root of the stubs directory.",
        ),
    },
)
